# Copy to .env and adjust. python-dotenv loads this at settings import time.
# A variable written as `FOO=` is *defined and empty*, which is how a blank signing key
# gets used as if it were real — so optional values are commented out, not left blank.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true

# --- datastores -----------------------------------------------------------------------
# These match docker-compose.dev.yml's default host ports, chosen not to collide with
# telehealth-clinical-api (55432 / 56379) or anything already on 5432 / 6379.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55433
POSTGRES_DB=telehealth_billing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_URL=redis://127.0.0.1:56380/0

# --- the contract with telehealth-clinical-api ------------------------------------------
# The exact same value must be set as INTERNAL_SERVICE_TOKEN in the Rails service.
INTERNAL_SERVICE_TOKEN=shared-with-the-clinical-service

# --- secrets ----------------------------------------------------------------------------
# Development falls back to a well-known key; production refuses to boot without one.
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=billing.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://billing.example.com

# Stripe. Without these the service still runs: invoices are created locally and the
# PaymentIntent step is skipped with a log line. `stripe listen` prints the webhook secret.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio and Mailgun. Without them, notification tasks log what they would have sent
# instead of failing — see notifications/tasks.py.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15550000000
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM=Telehealth <no-reply@example.com>

# Google OAuth (the audience the id_token must be issued for).
# GOOGLE_OAUTH_CLIENT_ID=
